# Executed on Ubuntu only. Toolchain specified by the project owner.
TOOLCHAIN_BIN=/opt/rk3568/gcc-arm-9.2-2019.12-x86_64-aarch64-none-linux-gnu/bin
export PATH="$TOOLCHAIN_BIN:$PATH"
HOST=aarch64-none-linux-gnu
CC="$TOOLCHAIN_BIN/$HOST-gcc"
CXX="$TOOLCHAIN_BIN/$HOST-g++"
AR="$TOOLCHAIN_BIN/$HOST-ar"
RANLIB="$TOOLCHAIN_BIN/$HOST-ranlib"
STRIP="$TOOLCHAIN_BIN/$HOST-strip"
# Keep flags explicit; put board-specific ABI/sysroot options here if required.
CFLAGS='-O2 -g'
